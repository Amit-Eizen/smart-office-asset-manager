# Example environment configuration for Smart Office Asset Manager
# Copy this file to .env.dev and update the values

# SQL Server Configuration
SQL_SERVER_PASSWORD=*ChooseYourDbPassword*
SQL_DATABASE_NAME=*ChooseYourDatabaseName*

# MongoDB Configuration
MONGO_DATABASE_NAME=*ChooseYourMongoDatabaseName*

# JWT Configuration
JWT_SECRET=*ChooseYourJwtSecretKey*
JWT_ISSUER=*WhoCreatesTheToken*
JWT_AUDIENCE=*WhoIsTheTokenFor*
JWT_EXPIRY_MINUTES=*TokenExpiryInMinutes*
