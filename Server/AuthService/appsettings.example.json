{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=*YourServerName*;Database=*YourDatabaseName*;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "*YourJwtSecretKeyAtLeast32Characters*",
    "Issuer": "*WhoCreatesTheToken*",
    "Audience": "*WhoIsTheTokenFor*",
    "ExpiryInMinutes": "*TokenExpiryInMinutes*"
  },
  "Cors": {
    "AllowedOrigins": ["ChooseYourAllowedOriginsHere"]
  }
}
